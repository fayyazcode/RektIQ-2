{
  "name": "rektoiq",
  "version": "2.0.0",
  "private": true,
  "description": "RektoIQ crypto intelligence platform: hourly news ingestion, social sentiment consensus, and AI-assisted X posts.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit --project tsconfig.check.json",
    "test": "vitest run",
    "job:ingest": "tsx --conditions=react-server scripts/ingest.ts",
    "job:posts": "tsx --conditions=react-server scripts/daily-posts.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "job:cleanup": "tsx --conditions=react-server scripts/cleanup.ts",
    "job:sync-posts": "tsx --conditions=react-server scripts/sync-posts.ts",
    "job:social-sentiment": "tsx --conditions=react-server scripts/social-sentiment.ts",
    "job:realtime": "tsx --conditions=react-server scripts/realtime-worker.ts",
    "job:anomalies": "tsx --conditions=react-server scripts/anomalies-worker.ts",
    "job:news-correlation": "tsx --conditions=react-server scripts/news-correlation.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:env": "tsx scripts/check-env.ts",
    "db:check-schema": "tsx --conditions=react-server scripts/db/check-schema.ts",
    "db:apply-migration": "tsx --conditions=react-server scripts/db/apply-migration.ts",
    "prebuild": "node scripts/check-secrets.mjs && node scripts/check-workflows.mjs",
    "postbuild": "node scripts/check-secrets.mjs --output",
    "check:workflows": "node scripts/check-workflows.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@next/env": "^16.3.6",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "drizzle-orm": "0.45.3",
    "jose": "^6.2.12",
    "lightweight-charts": "^5.2.1",
    "next": "^16.3.6",
    "postgres": "3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rss-parser": "^3.13.0",
    "server-only": "^0.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20.9"
  }
}
