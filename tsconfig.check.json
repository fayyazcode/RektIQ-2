{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "src/lib/jobs/**/*.ts",
    "src/lib/db/client.ts",
    "src/lib/score/**/*.ts",
    "src/lib/signals/**/*.ts",
    "src/lib/anomalies/**/*.ts",
    "src/lib/news/**/*.ts",
    "src/lib/social/**/*.ts",
    "src/lib/ai-intel/**/*.ts",
    "src/lib/market/**/*.ts",
    "src/lib/feeds/**/*.ts",
    "src/lib/normalize/**/*.ts",
    "src/lib/ai/**/*.ts",
    "src/lib/config.ts",
    "src/lib/env.ts",
    "src/lib/settings.ts",
    "src/lib/notify-site.ts",
    "src/lib/github.ts",
    "src/lib/auth/**/*.ts",
    "src/lib/supabase/**/*.ts",
    "src/lib/prices.ts",
    "src/lib/format.ts",
    "src/lib/types.ts",
    "src/lib/api/**/*.ts",
    "src/app/api/**/*.ts",
    "!src/app/api/anomalies/route.ts",
    "!src/app/api/degen/route.ts",
    "!src/app/api/live/route.ts",
    "!src/app/api/market/assets/route.ts",
    "!src/app/api/market/assets/[symbol]/route.ts",
    "!src/app/api/market/overview/route.ts",
    "!src/app/api/news/impact/route.ts",
    "!src/app/api/news/impact/[id]/route.ts",
    "!src/app/api/provider-health/route.ts",
    "!src/app/api/revalidate/route.ts",
    "!src/app/api/**/route.ts",
    "src/app/(site)/**/*.tsx",
    "!src/app/(site)/page.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "src/lib/db.ts",
    "src/lib/data/**/*",
    "src/app/admin/actions.ts",
    "src/app/admin/**/*.tsx",
    "src/lib/ai-intel/explainer.ts",
    "src/lib/db-info.ts",
    "scripts/**/*.ts",
    "scripts/db/**/*.ts",
    "src/app/api/anomalies/route.ts",
    "src/app/api/degen/route.ts",
    "src/app/api/live/route.ts",
    "src/app/api/market/assets/route.ts",
    "src/app/api/market/assets/[symbol]/route.ts",
    "src/app/api/market/overview/route.ts",
    "src/app/api/news/impact/route.ts",
    "src/app/api/news/impact/[id]/route.ts",
    "src/app/api/provider-health/route.ts",
    "src/app/api/revalidate/route.ts"
  ]
}